# Konfigurasi contoh untuk LAB LOKAL. Salin ke .env: cp .env.contoh .env
# Nilai di bawah sengaja sama dengan docker-compose.yml (kredensial lab sintetis,
# bukan kredensial nyata). Jika mengubah user/password/vhost/database di
# docker-compose.yml, ubah juga di sini.

# RabbitMQ: amqp://<user>:<password>@<host>:5672/<vhost>
RABBITMQ_URL=amqp://a09user:a09pass@localhost:5672/a09vhost

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=a09db
PGUSER=a09user
PGPASSWORD=a09pass

# Identitas run pengujian: menjadi prefiks event_id (run01-N01, ...).
# Ganti (mis. run02) untuk pengujian baru agar bukti tidak bercampur.
RUN_ID=run01

# Opsional: port dashboard (default 3000)
# PORT=3000
